@baseUrl = http://localhost:3000
@token =
# =====================================================================
# REST CLIENT API TEST SUITE
# Gunakan VSCode REST Client
#
# Pastikan kamu sudah memilih environment:
#   Ctrl + Shift + P → "Rest Client: Switch Environment" → pilih "local"
#
# baseUrl diambil dari .rest-client.env.json
# =====================================================================


#########################################################
# 1) ROOT TEST (Server Hidup?)
#########################################################
GET {{baseUrl}}/
Accept: application/json

# Expected: 200 OK
# Response example:
# { "message": "API Works!" }



#########################################################
# 2) REGISTER (buat user baru)
#########################################################
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "password123"
}

# Expected: 200 / 201
# Jika email duplicate → 400 / 409



#########################################################
# 3) LOGIN (ambil JWT token)
#########################################################
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "password123"
}

# Expected: 200 OK
# Response body: { "token": "..." }
# Copy token lalu masukkan ke:
# .rest-client.env.json → "token": "<JWT>" 


#########################################################
# 4) ME (Protected Route — pakai token)
#########################################################
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}
Accept: application/json

# Expected: 200 OK + user info



#########################################################
# 5) NEGATIVE — tanpa token (HARUS error)
#########################################################
GET {{baseUrl}}/api/auth/me
Accept: application/json

# Expected: 401 Unauthorized



#########################################################
# 6) NEGATIVE — Register invalid
#########################################################
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "invalid-email",
  "password": "123"
}

# Expected: 400 Bad Request (validasi)



#########################################################
# 7) NEGATIVE — Password salah (login gagal)
#########################################################
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "wrongpassword"
}

# Expected: 401 Unauthorized



#########################################################
# 8) NEGATIVE — Token invalid
#########################################################
GET {{baseUrl}}/api/auth/me
Authorization: Bearer invalid.token.here
Accept: application/json

# Expected: 401 Unauthorized



#########################################################
# 9) Rate-limit test (opsional)
#########################################################
# Kirim 6x request berikut dalam waktu 10–15 detik

POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "wrongpassword"
}

# Expected: 429 Too Many Requests (kalau limiter aktif)