@baseUrl = http://localhost:3000
@token =
@refreshToken =

# =====================================================================
# REST CLIENT API TEST SUITE (updated)
# - Jika pakai .rest-client.env.json: pastikan environment "local" aktif.
# - Setelah login: copy token -> .rest-client.env.json "token": "<JWT>"
#   atau edit baris @token di atas untuk testing cepat.
# =====================================================================

### 1) ROOT TEST (Server Hidup?)
GET {{baseUrl}}/
Accept: application/json

### 2) REGISTER (buat user baru)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "password123"
}

### 3) LOGIN (ambil JWT token + refreshToken)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "password123"
}

# Expected response: { "token": "<JWT>", "refreshToken": "<REFRESH>" }
# Copy values and simpan ke .rest-client.env.json OR ganti baris @token/@refreshToken di atas

### 4) REFRESH TOKEN (dapatkan access token baru)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 5) LOGOUT (revoke refresh token)
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 6) REQUEST RESET (generate reset token — returned in response for testing)
POST {{baseUrl}}/api/auth/request-reset
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com"
}

# The response will include the plain reset token (in this implementation).
# Copy that token for the reset step below.

### 7) RESET PASSWORD (pakai token dari request-reset)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "token": "<PASTE_RESET_TOKEN_FROM_REQUEST_RESET>",
  "password": "newPassword123"
}

### 8) ME (Protected Route — pakai access token)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}
Accept: application/json

### 9) NEGATIVE — tanpa token (HARUS error)
GET {{baseUrl}}/api/auth/me
Accept: application/json

### 10) NEGATIVE — Register invalid
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "invalid-email",
  "password": "123"
}

### 11) NEGATIVE — Login dengan password salah
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "wrongpassword"
}

### 12) NEGATIVE — Token invalid
GET {{baseUrl}}/api/auth/me
Authorization: Bearer invalid.token.here
Accept: application/json

### 13) RATE-LIMIT TEST (opsional)
# Kirim request login (wrong password) berkali-kali cepat untuk memicu limiter
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@mail.com",
  "password": "wrongpassword"
}